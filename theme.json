{
  "$schema": "https://schemas.wp.org/wp/6.8/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "name": "Background",
          "slug": "background",
          "color": "#F2F2F2"
        },
        {
          "color": "#FFFFFF",
          "name": "White",
          "slug": "white"
        },
        {
          "color": "#2C2C2C",
          "name": "Black",
          "slug": "black"
        },
        {
          "color": "#1080FF",
          "name": "Blue",
          "slug": "blue"
        },
        {
          "color": "#FFD900",
          "name": "Yellow",
          "slug": "yellow"
        },
        {
          "color": "#F03AA6",
          "name": "Pink",
          "slug": "pink"
        }
      ]
    },
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1440px"
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "name": "Tiny",
          "size": "10px",
          "slug": "20"
        },
        {
          "name": "X-Small",
          "size": "20px",
          "slug": "30"
        },
        {
          "name": "Small",
          "size": "30px",
          "slug": "40"
        },
        {
          "name": "Regular",
          "size": "clamp(30px, 5vw, 50px)",
          "slug": "50"
        },
        {
          "name": "Large",
          "size": "clamp(30px, 7vw, 70px)",
          "slug": "60"
        },
        {
          "name": "X-Large",
          "size": "clamp(50px, 7vw, 90px)",
          "slug": "70"
        },
        {
          "name": "XX-Large",
          "size": "clamp(70px, 10vw, 140px)",
          "slug": "80"
        }
      ],
      "units": [
        "%",
        "px",
        "em",
        "rem",
        "vh",
        "vw"
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontSizes": [
        {
          "slug": "xx-small",
          "name": "2X Small",
          "size": "0.75rem",
          "fluid": false
        },
        {
          "slug": "x-small",
          "name": "X Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "small",
          "name": "Small",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "1.25rem",
          "fluid": {
            "min": "1.125rem",
            "max": "1.25rem"
          }
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.75rem",
          "fluid": {
            "min": "1.375rem",
            "max": "1.75rem"
          }
        },
        {
          "slug": "x-large",
          "name": "X Large",
          "size": "2.25rem",
          "fluid": {
            "min": "1.75rem",
            "max": "2.25rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "2X Large",
          "size": "3rem",
          "fluid": {
            "min": "2.125rem",
            "max": "3rem"
          }
        },
        {
          "slug": "xxx-large",
          "name": "3X Large",
          "size": "3.75rem",
          "fluid": {
            "min": "2.5rem",
            "max": "3.75rem"
          }
        }
      ],
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
          "name": "System Font",
          "slug": "system-font"
        },
        {
          "name": "Manrope",
          "slug": "manrope",
          "fontFamily": "Manrope, sans-serif",
          "fontFace": [
            {
              "src": [
                "file:./assets/fonts/manrope/Manrope-VariableFont_wght.woff2"
              ],
              "fontWeight": "200 800",
              "fontStyle": "normal",
              "fontFamily": "Manrope"
            }
          ]
        },
        {
          "name": "Inter",
          "slug": "inter",
          "fontFamily": "Inter, sans-serif",
          "fontFace": [
            {
              "src": [
                "file:./assets/fonts/inter/Inter-VariableFont_opsz_wght.woff2"
              ],
              "fontWeight": "100 800",
              "fontStyle": "normal",
              "fontFamily": "Inter"
            },
            {
              "src": [
                "file:./assets/fonts/inter/Inter-Italic-VariableFont_opsz_wght.woff2"
              ],
              "fontWeight": "100 800",
              "fontStyle": "italic",
              "fontFamily": "Inter"
            }
          ]
        },
        {
          "name": "Montserrat",
          "slug": "montserrat",
          "fontFamily": "Montserrat, sans-serif",
          "fontFace": [
            {
              "src": [
                "file:./assets/fonts/montserrat/Montserrat-VariableFont_wght.woff2"
              ],
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "fontFamily": "Montserrat"
            },
            {
              "src": [
                "file:./assets/fonts/montserrat/Montserrat-Italic-VariableFont_wght.woff2"
              ],
              "fontWeight": "100 900",
              "fontStyle": "italic",
              "fontFamily": "Montserrat"
            }
          ]
        },
        {
          "name": "Open Sans",
          "slug": "open-sans",
          "fontFamily": "\"Open Sans\", sans-serif",
          "fontFace": [
            {
              "src": [
                "file:./assets/fonts/open-sans/OpenSans-VariableFont_wdth_wght.woff2"
              ],
              "fontWeight": "300 800",
              "fontStyle": "normal",
              "fontFamily": "Open Sans"
            },
            {
              "src": [
                "file:./assets/fonts/open-sans/OpenSans-Italic-VariableFont_wdth_wght.woff2"
              ],
              "fontWeight": "300 800",
              "fontStyle": "italic",
              "fontFamily": "Open Sans"
            }
          ]
        },
        {
          "name": "Poppins",
          "slug": "poppins",
          "fontFamily": "Poppins, sans-serif",
          "fontFace": [
            {
              "src": [
                "file:./assets/fonts/poppins/Poppins-VariableFont_wght.woff2"
              ],
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "fontFamily": "Poppins"
            },
            {
              "src": [
                "file:./assets/fonts/poppins/Poppins-Italic-VariableFont_wght.woff2"
              ],
              "fontWeight": "100 900",
              "fontStyle": "italic",
              "fontFamily": "Poppins"
            }
          ]
        },
        {
          "name": "Quicksand",
          "slug": "quicksand",
          "fontFamily": "Quicksand, sans-serif",
          "fontFace": [
            {
              "src": [
                "file:./assets/fonts/quicksand/Quicksand-VariableFont_wght.woff2"
              ],
              "fontWeight": "300 700",
              "fontStyle": "normal",
              "fontFamily": "Quicksand"
            }
          ]
        },
        {
          "name": "Roboto",
          "slug": "roboto",
          "fontFamily": "Roboto, sans-serif",
          "fontFace": [
            {
              "src": [
                "file:./assets/fonts/roboto/Roboto-VariableFont_wdth_wght.woff"
              ],
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "fontFamily": "Roboto"
            },
            {
              "src": [
                "file:./assets/fonts/roboto/Roboto-Italic-VariableFont_wdth_wght.woff"
              ],
              "fontWeight": "100 900",
              "fontStyle": "italic",
              "fontFamily": "Roboto"
            }
          ]
        },
        {
          "name": "Merriweather",
          "slug": "merriweather",
          "fontFamily": "Merriweather, serif",
          "fontFace": [
            {
              "src": [
                "file:./assets/fonts/merriweather/Merriweather-VariableFont_opsz_wdth_wght.woff2"
              ],
              "fontWeight": "300 900",
              "fontStyle": "normal",
              "fontFamily": "Merriweather"
            },
            {
              "src": [
                "file:./assets/fonts/merriweather/Merriweather-Italic-VariableFont_opsz_wdth_wght.woff2"
              ],
              "fontWeight": "300 900",
              "fontStyle": "italic",
              "fontFamily": "Merriweather"
            }
          ]
        },
        {
          "name": "Radio Canada Big",
          "slug": "radio-canada-big",
          "fontFamily": "\"Radio Canada Big\", sans-serif",
          "fontFace": [
            {
              "src": [
                "file:./assets/fonts/radio-canada-big/RadioCanadaBig-VariableFont_wght.woff2"
              ],
              "fontWeight": "400 700",
              "fontStyle": "normal",
              "fontFamily": "Radio Canada Big"
            },
            {
              "src": [
                "file:./assets/fonts/radio-canada-big/RadioCanadaBig-Italic-VariableFont_wght.woff2"
              ],
              "fontWeight": "400 700",
              "fontStyle": "italic",
              "fontFamily": "Radio Canada Big"
            }
          ]
        },
        {
          "name": "Playball",
          "slug": "playball",
          "fontFamily": "Playball, cursive",
          "fontFace": [
            {
              "src": [
                "file:./assets/fonts/playball/Playball-Regular.woff2"
              ],
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontFamily": "Playball"
            }
          ]
        },
        {
          "name": "Raleway",
          "slug": "raleway",
          "fontFamily": "Raleway, sans-serif",
          "fontFace": [
            {
              "src": [
                "file:./assets/fonts/raleway/Raleway-VariableFont_wght.woff2"
              ],
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "fontFamily": "Raleway"
            },
            {
              "src": [
                "file:./assets/fonts/raleway/Raleway-Italic-VariableFont_wght.woff2"
              ],
              "fontWeight": "100 900",
              "fontStyle": "italic",
              "fontFamily": "Raleway"
            }
          ]
        }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|raleway",
      "fontSize": "var:preset|font-size|small",
      "fontWeight": "400"
    },
    "spacing": {
      "blockGap": "1rem",
      "padding": {
        "left": "var:preset|spacing|50",
        "right": "var:preset|spacing|50"
      }
    },
    "elements": {
      "button": {
        "color": {
          "background": "var:preset|color|yellow",
          "text": "var:preset|color|black"
        },
        "css": "&{box-shadow: 0 0 0px 1px rgba(0,0,0,1);transition: all 0.3s ease-in-out;}&:hover {box-shadow: 0 0 0px 1px rgba(0,0,0,0);}",
        "spacing": {
          "padding": {
            "top": "13px",
            "right": "36px",
            "bottom": "13px",
            "left": "36px"
          }
        },
        "border": {
          "color": "var:preset|color|white",
          "width": "2px",
          "style": "solid",
          "radius": "50px"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|white",
            "text": "var:preset|color|black"
          },
          "border": {
            "color": "var:preset|color|yellow"
          }
        }
      },
      "caption": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "lineHeight": "1.4"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|xxx-large"
        },
        "spacing": {
          "margin": {
            "top": "10px",
            "bottom": "10px"
          }
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large"
        },
        "spacing": {
          "margin": {
            "top": "10px",
            "bottom": "10px"
          }
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large"
        },
        "spacing": {
          "margin": {
            "top": "10px",
            "bottom": "10px"
          }
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large"
        },
        "spacing": {
          "margin": {
            "top": "5px",
            "bottom": "5px"
          }
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "fontFamily": "var:preset|font-family|raleway"
        },
        "spacing": {
          "margin": {
            "top": "5px",
            "bottom": "5px"
          }
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontFamily": "var:preset|font-family|raleway",
          "textTransform": "uppercase"
        },
        "spacing": {
          "margin": {
            "top": "5px",
            "bottom": "5px"
          }
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "800",
          "lineHeight": "1"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|black"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|blue"
          }
        }
      }
    },
    "blocks": {
      "core/query": {},
      "core/post-template": {
        "spacing": {
          "padding": {
            "top": "0",
            "bottom": "10px",
            "left": "0",
            "right": "0"
          }
        },
        "css": ".wp-block-post-template .wp-block-post {display: flex;flex-direction: column;border-radius: 10px;overflow: hidden;background: white;padding-bottom: 10px;box-shadow: 0px 20px 40px 0px rgba(4, 5, 40, 0.04);}"
      },
      "core/post-title": {
        "color": {
          "text": "var:preset|color|black"
        },
        "typography": {
          "fontSize": "1.375rem",
          "lineHeight": "1.3"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "0",
            "left": "0",
            "right": "0"
          },
          "padding": {
            "top": "10px",
            "bottom": "5px",
            "left": "20px",
            "right": "20px"
          }
        }
      },
      "core/post-date": {
        "typography": {
          "fontSize": "0.875rem",
          "lineHeight": "1.3"
        },
        "spacing": {
          "padding": {
            "top": "5px",
            "bottom": "5px",
            "left": "20px",
            "right": "20px"
          }
        },
        "css": "& time {background-color: var(--wp--preset--color--light-orange);color: #975e0c;padding: 2px 8px; border-radius: 5px;}"
      },
      "core/post-featured-image": {
        "css": ".& img {width: 100%; height: 204px;object-fit: cover;}"
      },
      "core/post-excerpt": {
        "color": {
          "text": "#333"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "0",
            "left": "0",
            "right": "0"
          },
          "padding": {
            "top": "5px",
            "bottom": "5px",
            "left": "20px",
            "right": "20px"
          }
        },
        "typography": {
          "fontSize": "0.938rem",
          "lineHeight": "1.3"
        }
      },
      "core/post-author": {
        "color": {
          "text": "#333"
        },
        "spacing": {
          "padding": {
            "top": "5px",
            "bottom": "5px",
            "left": "20px",
            "right": "20px"
          }
        },
        "typography": {
          "fontSize": "0.938rem",
          "lineHeight": "1.3",
          "fontWeight": "600"
        },
        "css": "&{align-items: center;} & img {border-radius: 9999px;}"
      },
      "core/button": {
        "variations": {
          "outline": {
            "css": ".wp-block-button__link:hover{background: var(--wp--preset--color--light-gray)}",
            "spacing": {
              "padding": {
                "top": "8px",
                "right": "25px",
                "bottom": "8px",
                "left": "25px"
              }
            },
            "border": {
              "color": "var:preset|color|light-gray",
              "width": "2px",
              "style": "solid",
              "radius": "5px"
            }
          },
          "blue": {
            "color": {
              "background": "var:preset|color|blue",
              "text": "var:preset|color|base"
            },
            "css": ".wp-block-button__link:hover{background: var(--wp--preset--color--dark-blue);border-color: var(--wp--preset--color--dark-blue)}",
            "spacing": {
              "padding": {
                "top": "8px",
                "right": "25px",
                "bottom": "8px",
                "left": "25px"
              }
            },
            "border": {
              "color": "var:preset|color|blue",
              "width": "2px",
              "style": "solid",
              "radius": "5px"
            }
          },
          "orange": {
            "color": {
              "background": "var:preset|color|orange",
              "text": "var:preset|color|base"
            },
            "css": ".wp-block-button__link:hover{background: var(--wp--preset--color--dark-orange);border-color: var(--wp--preset--color--dark-orange)}",
            "spacing": {
              "padding": {
                "top": "8px",
                "right": "25px",
                "bottom": "8px",
                "left": "25px"
              }
            },
            "border": {
              "color": "var:preset|color|orange",
              "width": "2px",
              "style": "solid",
              "radius": "5px"
            }
          }
        }
      },
      "core/navigation": {
        "elements": {
          "link": {
            ":hover": {
              "color": {
                "text": "var:preset|color|blue"
              }
            },
            "css": "&{border-radius: 30px;}",
            "typography": {
              "fontWeight": "400",
              "textDecoration": "none"
            }
          }
        }
      },
      "core/paragraph": {
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "5px"
          }
        }
      },
      "core/group": {}
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "header"
    },
    {
      "area": "footer",
      "name": "footer"
    }
  ]
}